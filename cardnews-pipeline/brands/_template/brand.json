{
  "name": "내 브랜드 (이 폴더를 복사해 brands/브랜드명/으로 쓰세요)",
  "guide": "README.md",
  "canvas": {"width": 1080, "height": 1350},
  "safe_area": {"top": 120, "right": 110, "bottom": 150, "left": 110},
  "fonts": {
    "family": "Pretendard",
    "css": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/static/pretendard.min.css"
  },
  "colors": {
    "primary": "#4F7CFF",
    "secondary": "#1E2A44",
    "accent": "#FFC857",
    "bg": "#101828",
    "text": "#FFFFFF",
    "ink": "#1F2937",
    "ink-2": "#6B7280",
    "muted": "#6B7280",
    "panel": "#FFFFFF",
    "track": "#EEF0F3",
    "bar": "#1E2A44",
    "bar-end": "#4F7CFF",
    "scrim": "rgba(16,24,40,.78)"
  },
  "default_bg": "bg",
  "type": {
    "cover": {"size": 100, "weight": 800, "line": 1.16, "tracking": "-0.025em"},
    "h":     {"size": 70,  "weight": 800, "line": 1.24, "tracking": "-0.023em"},
    "sub":   {"size": 36,  "weight": 500, "line": 1.5},
    "body":  {"size": 34,  "weight": 500, "line": 1.6},
    "outro": {"size": 74,  "weight": 800, "line": 1.24},
    "note":  {"size": 26,  "weight": 500, "line": 1.55}
  },
  "logo": {"files": {}, "default": "none", "ink_width": 180, "bottom": 170},
  "chrome": {"handle": "@your_brand", "teaser_bar": true, "page_counter": true, "grain": true, "end_label": "@your_brand"},
  "audit": {
    "min_font_px": 24,
    "bg_percentile": 98,
    "large_px": 48,
    "contrast": {"default": 4.5, "large": 3.0}
  }
}
